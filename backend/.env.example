APP_NAME=学径 LearnPath API
DATABASE_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_PRICE_IN_PER_1K=0.001
LLM_PRICE_OUT_PER_1K=0.002

# 游客每日生成次数（按 guest id 或 IP）
GUEST_DAILY_LIMIT=5

# AI 助手（Agent）
AGENT_MAX_ROUNDS=3
AGENT_DAILY_LIMIT=20
# 每用户每日 token 配额（按 llm_usage 聚合）
USER_DAILY_TOKEN_LIMIT=50000
# 可选：填了 Tavily 就用 Tavily 搜索，不填走 DuckDuckGo 免 key
TAVILY_API_KEY=

# GitHub 仓库导入
GITHUB_TOKEN=
